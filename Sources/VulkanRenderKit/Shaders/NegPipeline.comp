#version 450

// SwiftInvert render chain, Vulkan port of NegPipeline.metal (which itself
// mirrors NegPy's WGSL). One source file, one kernel per compilation:
// scripts/compile_vulkan_shaders.sh compiles it six times with -DKERNEL_*
// and checks the .spv binaries in next to this file (no build-time GLSL
// compiler dependency, matching the runtime-Metal-compile spirit).
//
// Differences from the Metal version are mechanical only:
//  - storage buffers of interleaved RGB floats instead of rgba32float
//    textures (every pass is per-pixel; buffers make upload/readback a
//    straight memcpy of RGBImage.pixels),
//  - 1-D dispatch over pixel index, bounds-checked against the push
//    constant `n`,
//  - log10/select/fmod/rint spelled in GLSL (log()*1/ln10, mix(bvec),
//    mod(), roundEven()).
// Uniform blocks are std140, which for these field sequences is
// byte-identical to the C/MSL layout mirrored in ShaderTypes.swift —
// VulkanLayoutTests pins that.

layout(local_size_x = 256) in;

// flags bit 0 (encode_u8 only): convert the Adobe-RGB-encoded display value
// to sRGB for direct presentation on an unmanaged canvas — the Linux stand-in
// for the Mac's ColorSync-tagged CGImage. Float/export paths never set it.
layout(push_constant) uniform Push { uint n; uint flags; } push;

const float PI = 3.14159265358979323846;

// ── Shared math helpers (mirrors NegPipeline.metal) ───────────────────────

float fast_sigmoid(float x) {
    if (x >= 0.0) { return 1.0 / (1.0 + exp(-x)); }
    float z = exp(x);
    return z / (1.0 + z);
}

// Numerically stable softplus log(1 + exp(x)).
float softplus(float x) {
    return max(x, 0.0) + log(1.0 + exp(-abs(x)));
}

// Working-space OETF (Adobe RGB 1998: pure 563/256 gamma, no linear segment).
float oetf_encode(float t) {
    float x = clamp(t, 0.0, 1.0);
    return pow(x, 0.45470693);
}

float log10f(float x) {
    return log(x) * 0.4342944819032518;
}

// ── CIELAB in the working space (linear Adobe RGB 1998, D65) — mirrors
//    LabColor.swift / NegPipeline.metal; constants must stay in sync. ──────
const mat3 WORKING_TO_XYZ = mat3(
    vec3(0.5767309, 0.2973769, 0.0270343),  // columns
    vec3(0.1855540, 0.6273491, 0.0706872),
    vec3(0.1881852, 0.0752741, 0.9911085));
const mat3 XYZ_TO_WORKING = mat3(
    vec3(2.0413690, -0.9692660, 0.0134474),
    vec3(-0.5649464, 1.8760108, -0.1183897),
    vec3(-0.3446944, 0.0415560, 1.0154096));
const vec3 WORKING_WHITE = vec3(0.95047, 1.0, 1.08883);
const float LAB_EPS = 0.008856;
const float LAB_KAPPA = 7.787;

vec3 rgb_to_lab(vec3 rgb) {
    vec3 xyz = (WORKING_TO_XYZ * max(rgb, vec3(0.0))) / WORKING_WHITE;
    vec3 f = mix(LAB_KAPPA * xyz + 16.0 / 116.0, pow(xyz, vec3(1.0 / 3.0)),
                 greaterThan(xyz, vec3(LAB_EPS)));
    return vec3(116.0 * f.y - 16.0, 500.0 * (f.x - f.y), 200.0 * (f.y - f.z));
}

vec3 lab_to_rgb(vec3 lab) {
    float fy = (lab.x + 16.0) / 116.0;
    vec3 f = vec3(lab.y / 500.0 + fy, fy, fy - lab.z / 200.0);
    vec3 f3 = f * f * f;
    vec3 xyz = mix((f - 16.0 / 116.0) / LAB_KAPPA, f3, greaterThan(f3, vec3(LAB_EPS)))
        * WORKING_WHITE;
    return max(XYZ_TO_WORKING * xyz, vec3(0.0));
}

// ── Gamut-aware chroma boost + Skin Protection rein (mirrors the MSL and
//    LabColor.swift — keep the literals in sync) ───────────────────────────
const float SKIN_HUE_CENTER_DEG = 52.0;
const float SKIN_HUE_SIGMA_DEG = 20.0;
const float SKIN_CHROMA_FULL = 35.0;
const float SKIN_CHROMA_ZERO = 60.0;
const float SKIN_L_LO = 15.0;
const float SKIN_L_HI = 95.0;
const float SKIN_CHROMA_GATE = 2.0;
const float SKIN_CEIL_AT_FULL = 22.0;
const float SKIN_KNEE_START_FRAC = 0.6;
const int GAMUT_ITERATIONS = 10;
const float GAMUT_TOL = 1e-4;

// 0 (not skin) … 1 (dead centre of the skin locus).
float skin_weight(float l_val, float a, float b) {
    float chroma = sqrt(a * a + b * b);
    if (chroma < SKIN_CHROMA_GATE) { return 0.0; }
    float hue_deg = atan(b, a) * 57.29577951308232;
    float dist = hue_deg - SKIN_HUE_CENTER_DEG;
    dist -= 360.0 * roundEven(dist / 360.0);
    float x = dist / SKIN_HUE_SIGMA_DEG;
    float w_hue = exp(-0.5 * x * x);
    float w_chroma = 1.0 - smoothstep(SKIN_CHROMA_FULL, SKIN_CHROMA_ZERO, chroma);
    float w_light = smoothstep(0.0, SKIN_L_LO, l_val)
        * (1.0 - smoothstep(SKIN_L_HI, 100.0, l_val));
    return w_hue * w_chroma * w_light;
}

// One-directional soft chroma ceiling inside the skin mask.
vec3 skin_chroma_rein(vec3 lab, float strength) {
    if (strength <= 0.0) { return lab; }
    float ceiling = SKIN_CEIL_AT_FULL / strength;
    float start = SKIN_KNEE_START_FRAC * ceiling;
    float span = ceiling - start;
    float chroma = sqrt(lab.y * lab.y + lab.z * lab.z);
    if (chroma <= start) { return lab; }
    float w = skin_weight(lab.x, lab.y, lab.z);
    if (w <= 0.0) { return lab; }
    float knee = start + span * (1.0 - exp(-(chroma - start) / span));
    float scale = (chroma + w * (knee - chroma)) / chroma;
    return vec3(lab.x, lab.y * scale, lab.z * scale);
}

// Raw in-gamut check (no lower clamp — the raw values ARE the decision).
bool in_gamut_lab(float l_val, float a, float b) {
    float fy = (l_val + 16.0) / 116.0;
    vec3 f = vec3(a / 500.0 + fy, fy, fy - b / 200.0);
    vec3 f3 = f * f * f;
    vec3 xyz = mix((f - 16.0 / 116.0) / LAB_KAPPA, f3, greaterThan(f3, vec3(LAB_EPS)))
        * WORKING_WHITE;
    vec3 rgb = XYZ_TO_WORKING * xyz;
    return rgb.x >= -GAMUT_TOL && rgb.x <= 1.0 + GAMUT_TOL
        && rgb.y >= -GAMUT_TOL && rgb.y <= 1.0 + GAMUT_TOL
        && rgb.z >= -GAMUT_TOL && rgb.z <= 1.0 + GAMUT_TOL;
}

// Effective boost: target if it fits, else a soft knee toward the bisected
// in-gamut headroom (caller ensures saturation > 1).
float gamut_aware_boost(vec3 lab, float saturation) {
    if (in_gamut_lab(lab.x, lab.y * saturation, lab.z * saturation)) { return saturation; }
    float lo = 1.0;
    float hi = saturation;
    bool still_ok = in_gamut_lab(lab.x, lab.y, lab.z);
    for (int i = 0; i < GAMUT_ITERATIONS; i++) {
        float mid = (lo + hi) / 2.0;
        if (still_ok && in_gamut_lab(lab.x, lab.y * mid, lab.z * mid)) {
            lo = mid;
        } else {
            hi = mid;
        }
    }
    float s_max = max(lo, 1.0 + GAMUT_TOL);
    float knee = s_max - 1.0;
    return 1.0 + knee * (1.0 - exp(-(saturation - 1.0) / knee));
}

// ── Levels remap (interactive histogram) — mirrors levels_remap in the MSL;
//    the 51-float layout is documented in ShaderTypes.swift. Declared with
//    its buffer, only for the kernels that consume it. ─────────────────────
#if defined(KERNEL_HISTOGRAM) || defined(KERNEL_ENCODE_F) || defined(KERNEL_ENCODE_U8)
layout(std430, binding = 2) readonly buffer Levels { float lv[]; };

float levels_remap(float e, int channel) {
    int count = int(lv[48 + channel]);
    if (count == 0) { return e; }
    int xs = channel * 16;
    int ys = xs + 8;
    float x0 = 0.0, y0 = 0.0;
    for (int i = 0; i < count; i++) {
        float x1 = lv[xs + i], y1 = lv[ys + i];
        if (e <= x1) {
            return y0 + (e - x0) * (y1 - y0) / max(x1 - x0, 1e-4);
        }
        x0 = x1;
        y0 = y1;
    }
    return y0 + (e - x0) * (1.0 - y0) / max(1.0 - x0, 1e-4);
}
#endif

// Separation Damping reference spread — K.separationDampingRefSpread.
const float SEPARATION_DAMPING_REF = 0.35;

float separation_damping_gain(float k, float damping, float chroma) {
    if (k <= 0.0) { return 0.0; }
    float h = (SEPARATION_DAMPING_REF - chroma) / (SEPARATION_DAMPING_REF + chroma);
    return min(pow(k, (1.0 - damping) + damping * h), 3.0);
}

// Color-mixer band constants — must match LabColor.bandCentersDeg /
// bandHalfWidthsDeg (order: Red, Yellow, Green, Blue).
const float BAND_CENTER_DEG[4] = float[4](25.0, 90.0, 135.0, 235.0);
const float BAND_HALFWIDTH_DEG[4] = float[4](45.0, 45.0, 50.0, 65.0);

// Region-mask constants — must match K.toneRegionSharpness / K.*ToneAnchor.
const float TONE_SHARPNESS = 3.5;
const float SHADOW_ANCHOR = 1.40;
const float HIGHLIGHT_ANCHOR = 0.30;
const float DARK_SHADOW_ANCHOR = 1.85;

// ═══════════════════════════════ Kernels ══════════════════════════════════

#ifdef KERNEL_NORMALIZE
layout(std430, binding = 0) readonly buffer Src { float src[]; };
layout(std430, binding = 1) writeonly buffer Dst { float dst[]; };
layout(std140, binding = 2) uniform NormU {
    vec4 floors;
    vec4 ceils;
    float wpOffset;
    float bpOffset;
    vec2 _pad;
} u;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= push.n) { return; }
    uint i = gid * 3u;

    const float epsilon = 1e-6;
    for (int ch = 0; ch < 3; ch++) {
        float logColor = log10f(max(src[i + ch], epsilon));
        float f = u.floors[ch] + u.wpOffset;
        float c = u.ceils[ch] + u.bpOffset;
        float delta = c - f;
        float denom = delta;
        if (abs(delta) < epsilon) { denom = delta >= 0.0 ? epsilon : -epsilon; }
        dst[i + ch] = (logColor - f) / denom;
    }
}
#endif

#if defined(KERNEL_CURVE) || defined(KERNEL_COLORPOP)
layout(std430, binding = 0) readonly buffer Src { float src[]; };
layout(std430, binding = 1) writeonly buffer Dst { float dst[]; };
layout(std140, binding = 2) uniform CurveU {
    vec4 pivots;
    vec4 slopes;
    vec4 curvatures;
    vec4 cmyOffsets;
    vec4 shadowCMY;
    vec4 midCMY;
    vec4 highlightCMY;
    vec4 dMinRGB;
    float toe;
    float shoulder;
    float toeWidth;
    float shoulderWidth;
    float dMax;
    float aToeBase;
    float aShBase;
    float widthRef;
    float toeHeight;
    float shHeight;
    float zoneCenter;
    float trueBlack;
    float darkShadowsLift;
    float vStar;
    float midtoneGamma;
    float gammaWidth;
    float shadowsLift;
    float shadowContrast;
    float highlightsShift;
    float highlightContrast;
    float vibrance;
    float saturation;
    float preSaturation;
    float printSaturation;
    vec4 bandHues;
    vec4 bandSaturations;
    float separationDamping;
    float skinProtection;
    float hueTrim;
    float _pad3;
} p;
#endif

#ifdef KERNEL_CURVE
// Asymmetric H&D print curve → LINEAR reflectance (mirrors printCurve).
void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= push.n) { return; }
    uint i = gid * 3u;
    vec3 color = vec3(src[i], src[i + 1u], src[i + 2u]);

    // Pre-saturation: scale density deviations from the per-pixel neutral.
    if (p.preSaturation != 1.0) {
        float m = (color.r + color.g + color.b) / 3.0;
        color = vec3(m) + p.preSaturation * (color - vec3(m));
    }

    const float eps = 1e-6;
    float a_hl = p.aShBase * p.widthRef / max(p.shoulderWidth, eps);
    float a_sh_base = p.aToeBase * p.widthRef / max(p.toeWidth, eps);
    float a_sh = p.toe >= 0.0 ? a_sh_base : a_sh_base * (1.0 - p.toe * 4.0);
    vec3 d_min_rgb = p.dMinRGB.xyz;
    vec3 d_min_eff = max(d_min_rgb + vec3(p.shoulder * p.shHeight), vec3(0.0));
    float d_max_base = p.toe >= 0.0 ? p.dMax - p.toe * p.toeHeight : p.dMax;
    vec3 d_max_eff = max(vec3(d_max_base), d_min_eff + vec3(0.1));
    // True Black (BPC) references the PHYSICAL d_max so toe lifts survive.
    float bpc_db = p.toe < 0.0 ? p.dMax + p.toe * p.toeHeight : p.dMax;
    float bpc_black = pow(10.0, -bpc_db);
    bool hasBandCMY = any(notEqual(p.shadowCMY.xyz, vec3(0.0)))
        || any(notEqual(p.midCMY.xyz, vec3(0.0)))
        || any(notEqual(p.highlightCMY.xyz, vec3(0.0)));

    vec3 dens;
    for (int ch = 0; ch < 3; ch++) {
        float val = color[ch] + p.cmyOffsets[ch];
        float v = p.slopes[ch] * (val - p.pivots[ch]) + p.curvatures[ch] * val * val;

        if (p.midtoneGamma != 0.0) {
            v = v + p.midtoneGamma * p.gammaWidth * tanh((v - p.vStar) / p.gammaWidth);
        }

        // Regional tone: sigmoid-masked shifts + anchor-pivoted contrast,
        // parallel form (both masks on the incoming v).
        if (p.shadowsLift != 0.0 || p.shadowContrast != 0.0 || p.darkShadowsLift != 0.0
            || p.highlightsShift != 0.0 || p.highlightContrast != 0.0) {
            float wS = fast_sigmoid(TONE_SHARPNESS * (v - SHADOW_ANCHOR));
            float wH = fast_sigmoid(TONE_SHARPNESS * (HIGHLIGHT_ANCHOR - v));
            float wDS = fast_sigmoid(TONE_SHARPNESS * (v - DARK_SHADOW_ANCHOR));
            v = v + (-p.shadowsLift + p.shadowContrast * (v - SHADOW_ANCHOR)) * wS
                  - p.darkShadowsLift * wDS
                  + (-p.highlightsShift + p.highlightContrast * (v - HIGHLIGHT_ANCHOR)) * wH;
        }

        // 3-band color balance on the tone-region masks (mids = remainder).
        if (hasBandCMY) {
            float wS = fast_sigmoid(TONE_SHARPNESS * (v - SHADOW_ANCHOR));
            float wH = fast_sigmoid(TONE_SHARPNESS * (HIGHLIGHT_ANCHOR - v));
            float wM = max(1.0 - wS - wH, 0.0);
            v = v + p.shadowCMY[ch] * wS + p.midCMY[ch] * wM + p.highlightCMY[ch] * wH;
        }

        float v1 = d_min_eff[ch] + softplus(a_hl * (v - d_min_eff[ch])) / a_hl;
        dens[ch] = d_max_eff[ch] - softplus(a_sh * (d_max_eff[ch] - v1)) / a_sh;
    }

    // Print Saturation: uniform k around the achromatic mean of density
    // above paper base.
    if (p.printSaturation != 1.0) {
        vec3 ve = dens - p.dMinRGB.xyz;
        float m = (ve.x + ve.y + ve.z) / 3.0;
        if (p.separationDamping > 0.0) {
            float chroma = sqrt(((ve.x - ve.y) * (ve.x - ve.y) + (ve.y - ve.z) * (ve.y - ve.z)
                + (ve.x - ve.z) * (ve.x - ve.z)) / 3.0);
            float k = separation_damping_gain(p.printSaturation, p.separationDamping, chroma);
            dens = p.dMinRGB.xyz + vec3(m) + k * (ve - vec3(m));
        } else {
            dens = p.dMinRGB.xyz + vec3(m) + p.printSaturation * (ve - vec3(m));
        }
    }
    vec3 transmittance = pow(vec3(10.0), -dens);
    if (p.trueBlack != 0.0) {
        transmittance = (transmittance - bpc_black) / (1.0 - bpc_black);
    }
    vec3 outv = clamp(transmittance, vec3(0.0), vec3(1.0));
    dst[i] = outv.x;
    dst[i + 1u] = outv.y;
    dst[i + 2u] = outv.z;
}
#endif

#ifdef KERNEL_COLORPOP
// Hue Trim → Color Mixer → vibrance → saturation (+ Skin Protection) in
// CIELAB on the linear print (mirrors colorPop).
void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= push.n) { return; }
    uint i = gid * 3u;
    vec3 result = vec3(src[i], src[i + 1u], src[i + 2u]);

    // Hue Trim: rotate about the neutral axis in a*b*; runs FIRST.
    if (p.hueTrim != 0.0) {
        vec3 lab = rgb_to_lab(result);
        float c = cos(p.hueTrim);
        float s = sin(p.hueTrim);
        lab = vec3(lab.x, lab.y * c - lab.z * s, lab.y * s + lab.z * c);
        result = clamp(lab_to_rgb(lab), vec3(0.0), vec3(1.0));
    }

    // Color mixer: chroma-gated hue-targeted bands, R/Y/G/B.
    if (any(notEqual(p.bandHues, vec4(0.0))) || any(notEqual(p.bandSaturations, vec4(1.0)))) {
        vec3 lab = rgb_to_lab(result);
        float chroma = length(lab.yz);
        float gate = smoothstep(6.0, 16.0, chroma);
        if (gate > 0.0) {
            float hueDeg = atan(lab.z, lab.y) * (180.0 / PI);
            float deltaDeg = 0.0;
            float chromaScale = 1.0;
            for (int b = 0; b < 4; ++b) {
                float dh = mod(hueDeg - BAND_CENTER_DEG[b] + 540.0, 360.0) - 180.0;
                float t = min(abs(dh) / BAND_HALFWIDTH_DEG[b], 1.0);
                float w = gate * 0.5 * (1.0 + cos(PI * t));
                deltaDeg += p.bandHues[b] * 30.0 * w;
                chromaScale *= 1.0 + (p.bandSaturations[b] - 1.0) * w;
            }
            if (deltaDeg != 0.0 || chromaScale != 1.0) {
                float newHue = (hueDeg + deltaDeg) * (PI / 180.0);
                float newChroma = chroma * max(chromaScale, 0.0);
                lab.y = newChroma * cos(newHue);
                lab.z = newChroma * sin(newHue);
                result = clamp(lab_to_rgb(lab), vec3(0.0), vec3(1.0));
            }
        }
    }

    if (p.vibrance != 1.0) {
        vec3 lab = rgb_to_lab(result);
        float chroma = length(lab.yz);
        float muted = clamp(1.0 - chroma / 60.0, 0.0, 1.0);
        float boost = 1.0 + (p.vibrance - 1.0) * muted;
        lab.yz *= boost;
        result = clamp(lab_to_rgb(lab), vec3(0.0), vec3(1.0));
    }
    if (p.saturation != 1.0 || p.skinProtection > 0.0) {
        vec3 lab = rgb_to_lab(result);
        if (p.saturation != 1.0) {
            // Boosts are gamut-aware; desaturation stays flat.
            float eff = p.saturation > 1.0 ? gamut_aware_boost(lab, p.saturation) : p.saturation;
            lab.yz *= eff;
        }
        // Skin Protection: after the scale, independent of it, reduce-only.
        lab = skin_chroma_rein(lab, p.skinProtection);
        result = clamp(lab_to_rgb(lab), vec3(0.0), vec3(1.0));
    }

    dst[i] = result.x;
    dst[i + 1u] = result.y;
    dst[i + 2u] = result.z;
}
#endif

#ifdef KERNEL_HISTOGRAM
layout(std430, binding = 0) readonly buffer Src { float src[]; };
layout(std430, binding = 1) buffer Bins { uint bins[]; };

// 4×256 bins (R, G, B, Rec.709 luma), reads the LINEAR content and encodes
// internally — including the levels remap, so bins are DISPLAYED values.
void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= push.n) { return; }
    uint i = gid * 3u;
    vec3 color = vec3(
        levels_remap(oetf_encode(src[i]), 0),
        levels_remap(oetf_encode(src[i + 1u]), 1),
        levels_remap(oetf_encode(src[i + 2u]), 2));
    float luma = dot(color, vec3(0.2126, 0.7152, 0.0722));

    uint binR = uint(clamp(color.r * 255.0, 0.0, 255.0));
    uint binG = uint(clamp(color.g * 255.0, 0.0, 255.0));
    uint binB = uint(clamp(color.b * 255.0, 0.0, 255.0));
    uint binL = uint(clamp(luma * 255.0, 0.0, 255.0));

    atomicAdd(bins[binR], 1u);
    atomicAdd(bins[256u + binG], 1u);
    atomicAdd(bins[512u + binB], 1u);
    atomicAdd(bins[768u + binL], 1u);
}
#endif

#ifdef KERNEL_ENCODE_F
layout(std430, binding = 0) readonly buffer Src { float src[]; };
layout(std430, binding = 1) writeonly buffer Dst { float dst[]; };

// sRGB from XYZ (D65) — duplicated in the u8 kernel; keep in sync.
const mat3 SRGB_FROM_XYZ = mat3(
    vec3(3.2404542, -0.9692660, 0.0556434),
    vec3(-1.5371385, 1.8760108, -0.2040259),
    vec3(-0.4985314, 0.0415560, 1.0572252));

float srgb_encode(float v) {
    return v <= 0.0031308 ? 12.92 * v : 1.055 * pow(v, 1.0 / 2.4) - 0.055;
}

// Working-space OETF encode + levels remap, float output (export/tests).
// flags bit 0 re-expresses the result as sRGB (the sRGB export leg —
// same transform as the display kernel, kept in float for 16-bit output).
void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= push.n) { return; }
    uint i = gid * 3u;
    vec3 e = vec3(
        levels_remap(oetf_encode(src[i]), 0),
        levels_remap(oetf_encode(src[i + 1u]), 1),
        levels_remap(oetf_encode(src[i + 2u]), 2));
    if ((push.flags & 1u) != 0u) {
        vec3 lin = pow(max(e, vec3(0.0)), vec3(2.19921875));
        vec3 srgbLin = clamp(SRGB_FROM_XYZ * (WORKING_TO_XYZ * lin), vec3(0.0), vec3(1.0));
        e = vec3(srgb_encode(srgbLin.x), srgb_encode(srgbLin.y), srgb_encode(srgbLin.z));
    }
    dst[i] = e.x;
    dst[i + 1u] = e.y;
    dst[i + 2u] = e.z;
}
#endif

#ifdef KERNEL_ENCODE_U8
layout(std430, binding = 0) readonly buffer Src { float src[]; };
layout(std430, binding = 1) writeonly buffer Dst { uint dst[]; };

// sRGB from XYZ (D65, linear) — the display leg of Adobe→sRGB; the Adobe
// leg reuses WORKING_TO_XYZ above.
const mat3 SRGB_FROM_XYZ = mat3(
    vec3(3.2404542, -0.9692660, 0.0556434),  // columns
    vec3(-1.5371385, 1.8760108, -0.2040259),
    vec3(-0.4985314, 0.0415560, 1.0572252));

float srgb_encode(float v) {
    return v <= 0.0031308 ? 12.92 * v : 1.055 * pow(v, 1.0 / 2.4) - 0.055;
}

// Display fast path: same encode, packed rgba8 (alpha 255) — the GPU
// quantizes and readback is 4× smaller (mirrors the rgba8unorm target).
// With flags bit 0, the Adobe-encoded result (levels included — the remap
// is a display-domain op) is re-expressed as sRGB: decode the pure-power
// TRC, gamut matrix, clamp (per-channel clip is fine for a canvas), sRGB
// piecewise OETF.
void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= push.n) { return; }
    uint i = gid * 3u;
    vec3 e = vec3(
        levels_remap(oetf_encode(src[i]), 0),
        levels_remap(oetf_encode(src[i + 1u]), 1),
        levels_remap(oetf_encode(src[i + 2u]), 2));
    if ((push.flags & 1u) != 0u) {
        vec3 lin = pow(max(e, vec3(0.0)), vec3(2.19921875));
        vec3 srgbLin = clamp(SRGB_FROM_XYZ * (WORKING_TO_XYZ * lin), vec3(0.0), vec3(1.0));
        e = vec3(srgb_encode(srgbLin.x), srgb_encode(srgbLin.y), srgb_encode(srgbLin.z));
    }
    dst[gid] = packUnorm4x8(vec4(e, 1.0));
}
#endif
